# Authentication Configuration
# Set to false to disable authentication (development mode)
NEXT_PUBLIC_AUTH_ENABLED=false

# Authentication Mode (password or passkey)
# - password: Traditional email/password authentication
# - passkey: Modern WebAuthn/biometric authentication
NEXT_PUBLIC_AUTH_MODE=password

# WebAuthn Configuration (only used when AUTH_MODE=passkey)
# Relying Party ID (your domain name without protocol or port)
RP_ID=localhost

# Relying Party Name (displayed during passkey creation)
RP_NAME=Todo App

# Relying Party Origin (full URL including protocol)
RP_ORIGIN=http://localhost:3000

# JWT Secret (CHANGE THIS IN PRODUCTION!)
# Generate a secure random string for production use
JWT_SECRET=your-secret-key-change-in-production-use-openssl-rand-base64-32
